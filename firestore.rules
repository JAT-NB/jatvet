rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function admin() { return request.auth != null && request.auth.uid == 'gnkMytvd1KQWVagzp952Oc5qSsk1'; }
  function access(uid) { return request.auth != null && (admin() || (request.auth.uid == uid &&
   (!exists(/databases/$(database)/documents/profiles/$(uid)) || get(/databases/$(database)/documents/profiles/$(uid)).data.enabled == true))); }
  function path(uid) { return /databases/$(database)/documents/workspaces/$(uid); }
  function previous(uid) { return exists(path(uid)) ? get(path(uid)).data.revision : 0; }
  match /profiles/{uid} {
   allow read: if admin() || (request.auth != null && request.auth.uid == uid);
   allow create, update: if admin() && request.resource.data.keys().hasOnly(['enabled','label']) && request.resource.data.enabled is bool && request.resource.data.label is string;
   allow delete: if false;
  }
  match /workspaces/{uid} {
   allow read: if access(uid);
   allow create, update: if access(uid) && request.resource.data.keys().hasOnly(['revision','count','updatedBy']) &&
    request.resource.data.revision == previous(uid) + 1 && request.resource.data.updatedBy == request.auth.uid &&
    request.resource.data.count is int && request.resource.data.count > 0 && request.resource.data.count <= 390;
   allow delete: if false;
   match /chunks/{chunk} {
    allow read: if access(uid);
    allow write: if access(uid) && getAfter(path(uid)).data.revision == previous(uid) + 1 &&
     (request.resource == null || (request.resource.data.keys().hasOnly(['payload']) && request.resource.data.payload is string && request.resource.data.payload.size() <= 400000));
   }
  }
  match /{document=**} { allow read, write: if false; }
 }
}
